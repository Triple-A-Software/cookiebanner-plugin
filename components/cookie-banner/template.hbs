<div
    class="cookie-banner hidden fixed z-50 inset-x-0 bottom-0 p-3 sm:inset-x-auto sm:left-5 sm:bottom-5 sm:p-0 sm:max-w-md w-full"
    role="dialog"
    aria-modal="false"
    aria-label="Cookie consent"
    tabindex="-1"
>
    <div
        class="relative flex flex-col gap-4 rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 pr-10 shadow-2xl shadow-black/10 ring-1 ring-black/5 dark:ring-white/5"
    >
        <button
            type="button"
            class="close-btn absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-full text-gray-400 hover:bg-gray-100 hover:text-gray-600 dark:hover:bg-gray-800 dark:hover:text-gray-200 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400"
        >
            <div class="i-tabler-x text-base"></div>
            <span class="sr-only">Close banner</span>
        </button>

        <div class="flex items-start gap-3">
            <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-100 text-amber-600 dark:bg-amber-500/15 dark:text-amber-400"
                aria-hidden="true"
            >
                <div class="i-tabler-cookie text-xl"></div>
            </div>
            <p class="flex-1 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                {{ properties.main_text }}
                {{#if relations.privacy_policy_page as privacy_policy_page }}
                    <a
                        href="{{ privacy_policy_page.route }}"
                        class="font-medium text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300 underline underline-offset-2"
                    >
                        {{ properties.privacy_policy_link_text }}
                    </a>
                {{/if}}
            </p>
        </div>

        <div class="flex flex-col-reverse sm:flex-row gap-2 sm:gap-3">
            <button
                type="button"
                class="deny-all-btn flex-1 rounded-lg border border-gray-300 dark:border-gray-700 px-4 py-2.5 text-sm font-semibold text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400"
            >
                {{ properties.deny_all_button_text }}
            </button>
            <button
                type="button"
                class="accept-all-btn flex-1 rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900"
            >
                {{ properties.accept_all_button_text }}
            </button>
        </div>
    </div>
</div>
