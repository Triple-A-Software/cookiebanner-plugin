<div
    class="flex flex-row items-start fixed bottom-0 border-t border-gray-300 dark:border-gray-800 w-screen bg-white dark:bg-gray-900"
    tabindex="-1"
>
    <div class="flex-1 flex flex-col gap-1">
        <div class="flex-1 p-2">
            <p>
                {{ properties.main_text }}
                {{#if relations.privacy_policy_page as privacy_policy_page }}
                    <a href="{{ privacy_policy_page.route }}" class="color-blue-600 hover:color-blue-500 underline">
                        {{ properties.privacy_policy_link_text }}
                    </a>
                {{/if}}
            </p>
        </div>
        <div class="flex flex-row gap-3">
            <button
                type="button"
                class="accept-all-btn bg-lime-600 hover:bg-lime-500 flex flex-row rounded-full py-2 px-5"
            >
                {{ properties.accept_all_button_text }}
            </button>
            <button
                type="button"
                class="deny-all-btn bg-red-600 hover:bg-red-500 flex flex-row rounded-full py-2 px-5"
            >
                {{ properties.deny_all_button_text }}
            </button>
        </div>
    </div>
    <div class="p-2">
        <button type="button" class="rounded-full p-2 hover:bg-gray-200 hover:text-gray-900">
            <div class="i-tabler-x"></div>
            <span class="sr-only">Close banner</span>
        </button>
    </div>
</div>

